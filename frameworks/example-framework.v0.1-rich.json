  "stages": [
    {
      "id": "warmup",
      "name": "开场互动",
      "hint": "问候 + 今日主题/福利预告 + 引导关注/扣字；给停留理由，不急着深讲品"
    },
    {
      "id": "trust",
      "name": "信任背书",
      "hint": "品牌/官方身份、自用或检测报告、售后政策；建立敢买的基础"
    },
    {
      "id": "pain",
      "name": "痛点切入",
      "hint": "先问肤质困扰与使用场景，让观众感到「在说我」，再引出产品"
    },
    {
      "id": "pitch",
      "name": "讲品卖点",
      "hint": "FABE：成分/特点→优势→用户利益→证据；聚焦 1–2 个核心卖点"
    },
    {
      "id": "compare",
      "name": "对比说明",
      "hint": "与日常价/渠道/用法对比；只讲差异与适合谁，避免贬低同行"
    },
    {
      "id": "price",
      "name": "价格锚点",
      "hint": "先报原价/日常价，再报直播价与差价金额；说清券后到手怎么算"
    },
    {
      "id": "coupon",
      "name": "发券上链",
      "hint": "明确几号链接、何时发券/领券、能否叠加；小黄车位置与操作口令"
    },
    {
      "id": "close",
      "name": "逼单促单",
      "hint": "真实库存/名额/截止时间 + 明确行动号召（直接拍/已拍扣字）"
    },
    {
      "id": "qa",
      "name": "答疑复购",
      "hint": "回弹幕肤质/用法/发货问题；引导关注下场、复购与加购关联品"
    }
  ]
